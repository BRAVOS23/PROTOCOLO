<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/activity_widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
  <TextView android:id="@+id/activity_widget_check" android:layout_width="32dp" android:layout_height="wrap_content" android:text="○" android:textSize="24sp" android:textColor="#A4B3CD"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/activity_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Atividade" android:textSize="14sp" android:textStyle="bold" android:textColor="#F1F5FF" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/activity_widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="05:40 · Pendente" android:textSize="12sp" android:textColor="#43DDC8" android:paddingTop="3dp"/>
  </LinearLayout>
</LinearLayout>
