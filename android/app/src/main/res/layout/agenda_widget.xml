<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_notification" android:contentDescription="Protocolo"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Atividades de hoje" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
      <TextView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A tua rotina do Início" android:textColor="#A4B3CD" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Abrir" android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/widget_button"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sem atividades hoje. Abre o Início para adicionar." android:paddingTop="20dp" android:textColor="#C0CEE7" android:textSize="14sp"/>
  <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp" android:divider="@android:color/transparent" android:dividerHeight="2dp"/>
</LinearLayout>
